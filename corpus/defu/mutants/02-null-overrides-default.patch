--- a/src/defu.ts
+++ b/src/defu.ts
@@ -16,7 +16,7 @@ function _defu<T>(baseObject: T, defaults: any, namespace = ".", merger?: Merger
 
     const value = (baseObject as Record<string, any>)[key];
 
-    if (value === null || value === undefined) {
+    if (value === undefined) {
       continue;
     }
 
