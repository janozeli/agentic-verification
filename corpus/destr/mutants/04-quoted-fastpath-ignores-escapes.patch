# Assumes any double-quoted string can be unwrapped by slicing off the quotes, forgetting JSON escape sequences, so a JSON string containing \n or \" comes back with literal backslashes instead of decoded characters.
diff --git a/src/index.ts b/src/index.ts
index 8a32589..76d9142 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -33,11 +33,7 @@ export function destr<T = unknown>(value: any, options: Options = {}): T {
   if (typeof value !== "string") {
     return value;
   }
-  if (
-    value[0] === '"' &&
-    value[value.length - 1] === '"' &&
-    value.indexOf("\\") === -1
-  ) {
+  if (value[0] === '"' && value[value.length - 1] === '"') {
     return value.slice(1, -1) as T;
   }
 
