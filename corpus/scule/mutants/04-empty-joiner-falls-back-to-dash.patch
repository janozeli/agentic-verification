# kebabCase defaults the joiner with || instead of ??, so an explicit empty-string joiner falls back to "-" and flatCase("foo-barBaz") returns "foo-bar-baz" instead of "foobarbaz".
diff --git a/src/index.ts b/src/index.ts
index f1983fd..9b47795 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -134,7 +134,7 @@ export function kebabCase<
   return str
     ? ((Array.isArray(str) ? str : splitByCase(str as string))
         .map((p) => p.toLowerCase())
-        .join(joiner ?? "-") as KebabCase<T, Joiner>)
+        .join(joiner || "-") as KebabCase<T, Joiner>)
     : "";
 }
 
