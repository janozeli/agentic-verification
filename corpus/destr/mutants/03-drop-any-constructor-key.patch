# Treats every "constructor" key as dangerous, so harmless data like {"constructor": "Ford"} loses the key even though only a constructor object carrying "prototype" can pollute.
diff --git a/src/index.ts b/src/index.ts
index 8a32589..f1c844d 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -8,13 +8,7 @@ const suspectConstructorRx =
 const JsonSigRx = /^\s*["[{]|^\s*-?\d{1,16}(\.\d{1,17})?([Ee][+-]?\d+)?\s*$/;
 
 function jsonParseTransform(key: string, value: any): any {
-  if (
-    key === "__proto__" ||
-    (key === "constructor" &&
-      value &&
-      typeof value === "object" &&
-      "prototype" in value)
-  ) {
+  if (key === "__proto__" || key === "constructor") {
     warnKeyDropped(key);
     return;
   }
