import CouponModel

/-! Every value test of the agent-style suite, as a theorem about the model.
    Generated by experiments/derivation/lean_cases.py; each `decide` is a
    kernel-checked certificate that the test is an instance of the model. -/

open CouponModel

-- returns 0 for an empty cart
example : subtotal ([]) = 0 := by decide
-- returns the price of a single item
example : subtotal ([⟨1000, 1⟩]) = 1000 := by decide
-- multiplies price by quantity
example : subtotal ([⟨500, 2⟩]) = 1000 := by decide
-- sums several items
example : subtotal ([⟨1000, 1⟩, ⟨500, 2⟩]) = 2000 := by decide
-- handles quantity 3
example : subtotal ([⟨100, 3⟩]) = 300 := by decide
-- handles a large cart
example : subtotal (List.replicate 10 ⟨100, 1⟩) = 1000 := by decide
-- returns the subtotal without a coupon
example : apply ([⟨1000, 1⟩]) (none) = 1000 := by decide
-- returns the subtotal of several items without a coupon
example : apply ([⟨1000, 1⟩, ⟨500, 2⟩]) (none) = 2000 := by decide
-- returns 0 for an empty cart without a coupon
example : apply ([]) (none) = 0 := by decide
-- applies a 10% coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 10, none⟩) = 900 := by decide
-- applies a 20% coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 20, none⟩) = 800 := by decide
-- applies a 50% coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 50, none⟩) = 500 := by decide
-- applies a 10% coupon to several items
example : apply ([⟨1000, 1⟩, ⟨500, 2⟩]) (some ⟨.percent 10, none⟩) = 1800 := by decide
-- applies a 100% coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 100, none⟩) = 0 := by decide
-- applies a 0% coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 0, none⟩) = 1000 := by decide
-- rounds percent discounts down
example : apply ([⟨999, 1⟩]) (some ⟨.percent 10, none⟩) = 900 := by decide
-- applies a fixed coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 300, none⟩) = 700 := by decide
-- applies a fixed coupon of 100
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 100, none⟩) = 900 := by decide
-- applies a fixed coupon to several items
example : apply ([⟨1000, 1⟩, ⟨500, 2⟩]) (some ⟨.fixed 500, none⟩) = 1500 := by decide
-- never returns a negative total with a fixed coupon
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 5000, none⟩) = 0 := by decide
-- returns 0 when the fixed coupon equals the subtotal
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 1000, none⟩) = 0 := by decide
-- returns a non-negative total
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 300, none⟩) ≥ 0 := by decide
-- ignores the coupon below the minimum subtotal
example : apply ([⟨1000, 1⟩]) (some ⟨.percent 10, some 5000⟩) = 1000 := by decide
-- applies the coupon above the minimum subtotal
example : apply ([⟨1000, 1⟩, ⟨500, 2⟩]) (some ⟨.percent 10, some 1500⟩) = 1800 := by decide
-- ignores a fixed coupon below the minimum subtotal
example : apply ([⟨1000, 1⟩]) (some ⟨.fixed 300, some 5000⟩) = 1000 := by decide

-- No value claim to translate: is defined; returns a number; does not mutate the input; is defined; returns a number; does not throw with a coupon
