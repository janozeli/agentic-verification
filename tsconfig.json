{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["src", "test", "experiments", "examples"],
  "exclude": ["**/*.cjs", "**/.stryker-tmp"]
}
