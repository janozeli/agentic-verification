{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.props.config.ts"
  },
  "coverageAnalysis": "perTest",
  "disableBail": true,
  "mutate": [
    "src/**/*.ts"
  ],
  "reporters": [
    "json",
    "clear-text"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation-props.json"
  },
  "tempDirName": ".stryker-tmp"
}
